<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DotNetArch.Core</RootNamespace>
    <AssemblyName>DotNetArch.Core</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Implementation layer of DotNetArch: scaffolding, configuration, host abstractions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates/**/*.tpl" WithCulture="false" LogicalName="Templates/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotNetArch.Core.Tests" />
  </ItemGroup>

</Project>
