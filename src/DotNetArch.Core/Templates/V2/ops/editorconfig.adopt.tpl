# EditorConfig marker added by `dotnet-arch fix` for an existing code base.
# It deliberately carries no formatting rules: turning rules on for code that was written without them would make
# `dotnet format --verify-no-changes` (and a CI lint stage) fail on untouched files. Adopt style rules in a dedicated
# formatting commit (copy the rules of a generated solution's .editorconfig, run `dotnet format`, review the diff).
root = true
