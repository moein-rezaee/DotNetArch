# Generated from Market source plus read-only Consul/Vault inventory.
# Customer-specific values and all credentials must be supplied outside git.
# Provider paths use the target customer's namespace at runtime.

IDENTITY_APP_VERSION=1.0.33
ASPNETCORE_ENVIRONMENT=${ASPNETCORE_ENVIRONMENT}
CONSUL_HTTP_ADDR=${CONSUL_HTTP_ADDR}
CONSUL_HTTP_TOKEN=${CONSUL_HTTP_TOKEN}
CONFIG_CENTER_PREFIX=${CONFIG_CENTER_PREFIX}
VAULT_ADDR=${VAULT_ADDR}
VAULT_TOKEN=${VAULT_TOKEN}
SECRET_STORE_PATH=${SECRET_STORE_PATH}
OTP_BASE_URL=${OTP_BASE_URL}
SQLSERVER_HOST=${SQLSERVER_HOST}
SQLSERVER_PORT=${SQLSERVER_PORT}
SQLSERVER_DB=${SQLSERVER_DB}
# Database passwords are secrets with no default; supply them from the secret store / environment.
# SQLSERVER_PASSWORD is required only when SQLSERVER_USER is set (no user and no password = Integrated Security).
SQLSERVER_PASSWORD=${SQLSERVER_PASSWORD}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
M2M_WOOSYNC_SERVICE_SECRET=${M2M_WOOSYNC_SERVICE_SECRET}

# Inventory evidence: Consul keys=2767, KV mounts=charmsho/sync/,nikplus/bot/,nikplus/online-shop/,nikplus/sync/,yekson/sync/

# IdentityService.Mcp process credentials (placeholders only; never commit real values).
COREVIA_MCP_BEARER_TOKEN=${COREVIA_MCP_BEARER_TOKEN}
COREVIA_MCP_APPROVAL=${COREVIA_MCP_APPROVAL}
COREVIA_MCP_DELEGATION=${COREVIA_MCP_DELEGATION}
