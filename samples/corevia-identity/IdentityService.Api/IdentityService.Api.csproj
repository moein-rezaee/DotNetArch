<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Version>1.0.53</Version>
    <Authors>Development Team</Authors>
    <Description>Identity Service API</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="MediatR" Version="12.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdentityService.Application\IdentityService.Application.csproj" />
    <ProjectReference Include="..\IdentityService.Infrastructure\IdentityService.Infrastructure.csproj" />
    <ProjectReference Include="..\IdentityService.Domain\IdentityService.Domain.csproj" />

    <!-- Corevia.Kit.* via published Nexus packages (see NuGet.config). -->
    <PackageReference Include="Corevia.Kit.Logging.Providers.Console" Version="1.0.2" />
    <PackageReference Include="Corevia.Kit.ErrorHandling.Core" Version="2.0.0" />
    <PackageReference Include="Corevia.Kit.Swagger.Core" Version="1.0.0" />
    <PackageReference Include="Corevia.Kit.JwtSecurity.Core" Version="1.0.0" />
    <PackageReference Include="Corevia.Kit.Config.Providers.Consul" Version="1.0.0" />
    <PackageReference Include="Corevia.Kit.Secrets.Providers.Vault" Version="1.0.0" />
    <PackageReference Include="Corevia.Kit.ConfigLoader.Core" Version="1.0.1" />
    <PackageReference Include="Corevia.Kit.ServiceDiscovery.Providers.Consul" Version="1.0.0" />
  </ItemGroup>

</Project>
