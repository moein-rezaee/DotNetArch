<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Docker builds can have slower network; avoid timeouts -->
    <add key="httpRequestTimeout" value="300" />
    <add key="httpRetries" value="10" />
    <add key="maxHttpRequestsPerSource" value="4" />
    <!-- Allow HTTP connections to Nexus (internal network only) -->
    <add key="allowInsecureConnections" value="true" />
  </config>
  <packageSources>
    <clear />
    <!-- Primary restore source: platform-private Nexus NuGet group. -->
    <!-- Credentials are injected at build time; never commit them here. -->
    <add key="NexusHosted" value="http://nexus.getcorevia.ir:8081/repository/nuget-group/index.json" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="NexusHosted">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
