{
  "Jwt": {
    "Issuer": "IdentityService",
    "Audience": "IdentityClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Mcp": {
    "ServerName": "identity-service-mcp",
    "ServerVersion": "0.1.0",
    "Audience": "identity-service-mcp",
    "Transport": "http",
    "HttpBindAddress": "127.0.0.1",
    "HttpPort": 5271,
    "HttpHttpsEnabled": false,
    "PrivateNetworkTrusted": false,
    "AllowedHosts": [
      "127.0.0.1",
      "localhost",
      "::1"
    ],
    "AllowedOrigins": []
  }
}
