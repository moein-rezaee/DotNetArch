<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.3.0</Version>
    <Authors>Moein Rezaee</Authors>
    <RepositoryUrl>https://github.com/moein-rezaee/DotNetArch.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- CI and Release builds must be warning-free and reproducible -->
  <PropertyGroup Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true' or '$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Anything but Release: single framework for quick iteration (Configuration may be unset at this point) -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Release: multi-targeted so the tool package works on both SDK lines -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Samples and kits are read-only references; they must never compile into the tool. -->
  <ItemGroup>
    <Compile Remove="$(MSBuildThisFileDirectory)samples/**;$(MSBuildThisFileDirectory)kits/**" />
  </ItemGroup>

</Project>
